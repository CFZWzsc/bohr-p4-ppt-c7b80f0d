{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "deck_ir",
  "type": "object",
  "required": ["ir_version", "pages", "totals"],
  "properties": {
    "ir_version": {"type": "string"},
    "schema": {"type": "string"},
    "case_id": {"type": "string"},
    "family": {"type": "string"},
    "theme": {
      "type": "object",
      "properties": {
        "source": {"enum": ["supplied_template", "builtin"]},
        "slide_size": {"type": "object"},
        "inherited": {"type": "object"}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "role", "title", "bullets", "evidence", "notes"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "role": {"type": "string"},
          "title": {"type": "string"},
          "claim": {"type": "string"},
          "bullets": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
          "bullet_sources": {"type": "array", "items": {"type": "string"}},
          "figures": {"type": "array"},
          "evidence": {
            "type": "object",
            "properties": {
              "paragraph_id": {"type": "string"},
              "source_id": {"type": "string"},
              "quote": {"type": "string"}
            }
          },
          "notes": {"type": "string"},
          "layout": {"enum": ["title", "body"]},
          "overflow": {"type": "boolean"}
        }
      }
    },
    "totals": {"type": "object"}
  }
}
